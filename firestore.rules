rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // UID-based administrator verification via /admins/{uid} in Cloud Firestore (no hardcoded emails)
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasActiveAdminDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (!('isActive' in getAdminDoc().data) || getAdminDoc().data.isActive == true);
    }

    function isAdmin() {
      return hasActiveAdminDoc() &&
        getAdminDoc().data.role in ['superadmin', 'content_manager', 'legal_reviewer', 'editor'];
    }

    function isSuperAdmin() {
      return hasActiveAdminDoc() &&
        getAdminDoc().data.role == 'superadmin';
    }

    // Entity Validation Helpers (Blueprint-aligned strict keys, types, and bounds)
    function isValidPolicy(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'categoryId', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'slug', 'categoryId', 'summary',
          'contextHeader', 'contextExplanation',
          'conceptA', 'conceptB', 'comparison',
          'simultaneousExplanation', 'generalContent', 'classifications',
          'requirementsHeader', 'requirements', 'processStepsHeader', 'processSteps', 'faqs',
          'thumbnail', 'instagramPostUrl', 'instagramThumbnail',
          'isCustomThumbnail', 'customThumbnail', 'autoThumbnail',
          'instagramDate', 'instagramAccountHandle',
          'status', 'sources', 'relatedPolicyIds', 'publicationDate', 'isFeatured',
          'createdAt', 'updatedAt', 'aiAssisted',
          'aiSummary', 'isAiSummaryApproved', 'aiSummaryGeneratedAt', 'instagramCaption'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 300 &&
        data.categoryId is string && data.categoryId.size() <= 128 &&
        data.status in ['draft', 'review', 'published'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 10000)) &&
        (!('contextHeader' in data) || (data.contextHeader is string && data.contextHeader.size() <= 300)) &&
        (!('contextExplanation' in data) || (data.contextExplanation is string && data.contextExplanation.size() <= 50000)) &&
        (!('conceptA' in data) || data.conceptA is map) &&
        (!('conceptB' in data) || data.conceptB is map) &&
        (!('comparison' in data) || data.comparison is map) &&
        (!('simultaneousExplanation' in data) || (data.simultaneousExplanation is string && data.simultaneousExplanation.size() <= 20000)) &&
        (!('generalContent' in data) || (data.generalContent is string && data.generalContent.size() <= 50000)) &&
        (!('classifications' in data) || (data.classifications is list && data.classifications.size() <= 30)) &&
        (!('requirementsHeader' in data) || (data.requirementsHeader is string && data.requirementsHeader.size() <= 300)) &&
        (!('requirements' in data) || (data.requirements is list && data.requirements.size() <= 50)) &&
        (!('processStepsHeader' in data) || (data.processStepsHeader is string && data.processStepsHeader.size() <= 300)) &&
        (!('processSteps' in data) || (data.processSteps is list && data.processSteps.size() <= 50)) &&
        (!('faqs' in data) || (data.faqs is list && data.faqs.size() <= 50)) &&
        (!('thumbnail' in data) || (data.thumbnail is string && data.thumbnail.size() <= 700000)) &&
        (!('instagramPostUrl' in data) || (data.instagramPostUrl is string && data.instagramPostUrl.size() <= 2000)) &&
        (!('instagramThumbnail' in data) || (data.instagramThumbnail is string && data.instagramThumbnail.size() <= 700000)) &&
        (!('isCustomThumbnail' in data) || data.isCustomThumbnail is bool) &&
        (!('customThumbnail' in data) || (data.customThumbnail is string && data.customThumbnail.size() <= 700000)) &&
        (!('autoThumbnail' in data) || (data.autoThumbnail is string && data.autoThumbnail.size() <= 700000)) &&
        (!('instagramDate' in data) || (data.instagramDate is string && data.instagramDate.size() <= 100)) &&
        (!('instagramAccountHandle' in data) || (data.instagramAccountHandle is string && data.instagramAccountHandle.size() <= 100)) &&
        (!('sources' in data) || (data.sources is list && data.sources.size() <= 50)) &&
        (!('relatedPolicyIds' in data) || (data.relatedPolicyIds is list && data.relatedPolicyIds.size() <= 50)) &&
        (!('publicationDate' in data) || (data.publicationDate is string && data.publicationDate.size() <= 100)) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('aiAssisted' in data) || data.aiAssisted is bool) &&
        (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 10000)) &&
        (!('isAiSummaryApproved' in data) || data.isAiSummaryApproved is bool) &&
        (!('aiSummaryGeneratedAt' in data) || (data.aiSummaryGeneratedAt is string && data.aiSummaryGeneratedAt.size() <= 64)) &&
        (!('instagramCaption' in data) || (data.instagramCaption is string && data.instagramCaption.size() <= 20000));
    }

    function isValidDeputyNews(data) {
      return data.keys().hasAll(['id', 'title', 'articleUrl', 'publicationDate', 'summary', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'articleUrl', 'thumbnailUrl', 'imageId',
          'publicationDate', 'summary', 'category', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.articleUrl is string && data.articleUrl.size() <= 2000 &&
        data.publicationDate is string && data.publicationDate.size() <= 100 &&
        data.summary is string && data.summary.size() <= 5000 &&
        data.status in ['draft', 'published'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 700000)) &&
        (!('imageId' in data) || (data.imageId is string && data.imageId.size() <= 128)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    function isValidHeroSlide(data) {
      return data.keys().hasAll(['id', 'title', 'imageUrl', 'order', 'isActive']) &&
        data.keys().hasOnly(['id', 'title', 'imageUrl', 'order', 'isActive', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.imageUrl is string && data.imageUrl.size() <= 700000 &&
        data.order is number &&
        data.isActive is bool &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'description', 'iconName', 'group', 'colorScheme']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 150 &&
        data.description is string && data.description.size() <= 1000 &&
        (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50)) &&
        (!('group' in data) || data.group in ['klaster', 'pilar']) &&
        (!('colorScheme' in data) || (data.colorScheme is string && data.colorScheme.size() <= 50));
    }

    function isValidAboutPage(data) {
      return data.keys().hasAll(['heading', 'subheading']) &&
        data.keys().hasOnly([
          'heading', 'subheading', 'description', 'profileImageUrl', 'profileImageUpdatedAt',
          'orgSectionTitle', 'orgTopLevelTitle', 'unitSectionTitle',
          'unitSectionSubtitle', 'units', 'updatedAt'
        ]) &&
        data.heading is string && data.heading.size() <= 300 &&
        data.subheading is string && data.subheading.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('profileImageUrl' in data) || (data.profileImageUrl is string && data.profileImageUrl.size() <= 700000)) &&
        (!('profileImageUpdatedAt' in data) || data.profileImageUpdatedAt == null || (data.profileImageUpdatedAt is string && data.profileImageUpdatedAt.size() <= 64)) &&
        (!('orgSectionTitle' in data) || (data.orgSectionTitle is string && data.orgSectionTitle.size() <= 200)) &&
        (!('orgTopLevelTitle' in data) || (data.orgTopLevelTitle is string && data.orgTopLevelTitle.size() <= 200)) &&
        (!('unitSectionTitle' in data) || (data.unitSectionTitle is string && data.unitSectionTitle.size() <= 200)) &&
        (!('unitSectionSubtitle' in data) || (data.unitSectionSubtitle is string && data.unitSectionSubtitle.size() <= 500)) &&
        (!('units' in data) || (data.units is list && data.units.size() <= 20 && (data.units.size() == 0 || data.units[0] is map))) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSource(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.keys().hasOnly([
          'id', 'title', 'regulationType', 'regulationNumber',
          'year', 'articles', 'fileUrl', 'description', 'isVerified'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
        (!('regulationType' in data) || (data.regulationType is string && data.regulationType.size() <= 150)) &&
        (!('regulationNumber' in data) || (data.regulationNumber is string && data.regulationNumber.size() <= 150)) &&
        (!('year' in data) || (data.year is string && data.year.size() <= 20)) &&
        (!('articles' in data) || (data.articles is string && data.articles.size() <= 500)) &&
        (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() <= 2000)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('isVerified' in data) || data.isVerified is bool);
    }

    function isValidAdminPermissions(perms) {
      return perms is map &&
        perms.keys().hasOnly([
          'canManageUsers', 'canPublishPolicies', 'canEditCategories',
          'canManageSources', 'canUseAI'
        ]) &&
        (!('canManageUsers' in perms) || perms.canManageUsers is bool) &&
        (!('canPublishPolicies' in perms) || perms.canPublishPolicies is bool) &&
        (!('canEditCategories' in perms) || perms.canEditCategories is bool) &&
        (!('canManageSources' in perms) || perms.canManageSources is bool) &&
        (!('canUseAI' in perms) || perms.canUseAI is bool);
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.keys().hasOnly([
          'uid', 'id', 'email', 'role', 'name', 'roleTitle',
          'department', 'permissions', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.role is string && data.role in ['superadmin', 'content_manager', 'legal_reviewer', 'editor'] &&
        (!('name' in data) || (data.name is string && data.name.size() <= 150)) &&
        (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 150)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 250)) &&
        (!('permissions' in data) || isValidAdminPermissions(data.permissions)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Collection Rules

    // 1. Policies Collection (Public reads published only; Admin full access)
    match /policies/{policyId} {
      allow get: if isValidId(policyId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published' || isAdmin();
      allow create: if isValidId(policyId) && isAdmin() && isValidPolicy(incoming()) && incoming().id == policyId;
      allow update: if isValidId(policyId) && isAdmin() && isValidPolicy(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'categoryId', 'summary',
          'contextHeader', 'contextExplanation',
          'conceptA', 'conceptB', 'comparison',
          'simultaneousExplanation', 'generalContent', 'classifications',
          'requirementsHeader', 'requirements', 'processStepsHeader', 'processSteps', 'faqs',
          'thumbnail', 'instagramPostUrl', 'instagramThumbnail',
          'isCustomThumbnail', 'customThumbnail', 'autoThumbnail',
          'instagramDate', 'instagramAccountHandle',
          'status', 'sources', 'relatedPolicyIds', 'publicationDate', 'isFeatured',
          'createdAt', 'updatedAt', 'aiAssisted',
          'aiSummary', 'isAiSummaryApproved', 'aiSummaryGeneratedAt', 'instagramCaption'
        ]);
      allow delete: if isValidId(policyId) && isAdmin();
    }

    // 2. Deputy News Collection (Public reads published only; Admin full access)
    match /deputy_news/{newsId} {
      allow get: if isValidId(newsId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published' || isAdmin();
      allow create: if isValidId(newsId) && isAdmin() && isValidDeputyNews(incoming()) && incoming().id == newsId;
      allow update: if isValidId(newsId) && isAdmin() && isValidDeputyNews(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'articleUrl', 'thumbnailUrl', 'imageId',
          'publicationDate', 'summary', 'category', 'status',
          'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(newsId) && isAdmin();
    }

    // 3. Hero Slides Collection (Public Read, Admin Write)
    match /hero_slides/{slideId} {
      allow get: if isValidId(slideId);
      allow list: if true;
      allow create: if isValidId(slideId) && isAdmin() && isValidHeroSlide(incoming()) && incoming().id == slideId;
      allow update: if isValidId(slideId) && isAdmin() && isValidHeroSlide(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'imageUrl', 'order', 'isActive', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(slideId) && isAdmin();
    }

    // 4. Categories Collection (Public Read, Admin Write)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().id == categoryId;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'iconName', 'group', 'colorScheme'
        ]);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 5. About Page Collection (Public reads 'main' doc; Admin full access)
    match /about_page/{docId} {
      allow get: if isValidId(docId) && (docId == 'main' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(docId) && isAdmin() && isValidAboutPage(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidAboutPage(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'heading', 'subheading', 'description', 'profileImageUrl', 'profileImageUpdatedAt',
          'orgSectionTitle', 'orgTopLevelTitle', 'unitSectionTitle',
          'unitSectionSubtitle', 'units', 'updatedAt'
        ]);
      allow delete: if isValidId(docId) && isAdmin();
    }

    // 6. Sources Collection (Public Read, Admin Write)
    match /sources/{sourceId} {
      allow get: if isValidId(sourceId);
      allow list: if true;
      allow create: if isValidId(sourceId) && isAdmin() && isValidSource(incoming()) && incoming().id == sourceId;
      allow update: if isValidId(sourceId) && isAdmin() && isValidSource(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'regulationType', 'regulationNumber',
          'year', 'articles', 'fileUrl', 'description', 'isVerified'
        ]);
      allow delete: if isValidId(sourceId) && isAdmin();
    }

    // 7. Admins Collection (Strict PII Isolation, UID-based RBAC, Superadmin-Only Management)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(adminId) && isSuperAdmin() && isValidAdmin(incoming()) && incoming().uid == adminId;
      allow update: if isValidId(adminId) && isSuperAdmin() && isValidAdmin(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'id', 'email', 'role', 'name', 'roleTitle', 'department',
          'permissions', 'isActive', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }
  }
}
