  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminProfile",
      "description": "Authorized administrator registry for RBAC verification (PII isolated to owner/admins)."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Policy clusters (8 Klaster Manajemen ASN) and thematic pillars (Sekolah Kedinasan)."
    },
    "/sources/{sourceId}": {
      "schema": "SourceDocument",
      "description": "Official JDIH regulatory source documents."
    },
    "/policies/{policyId}": {
      "schema": "Policy",
      "description": "Policy summaries and Instagram infographic educational posts."
    },
    "/deputyNews/{newsId}": {
      "schema": "DeputyNews",
      "description": "Official news articles from Kedeputian Bidang SDM Aparatur."
    },
    "/heroSlides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Homepage hero banner carousel slots."
    },
    "/siteContent/{docId}": {
      "schema": "AboutPageSiteContent",
      "description": "Singleton institutional page content such as aboutPage."
    }
  }
}
