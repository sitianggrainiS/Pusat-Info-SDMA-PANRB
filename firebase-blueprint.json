{
  "entities": {
    "Policy": {
      "title": "Policy",
      "description": "Artikel kebijakan dan konten Instagram edukasi SDM Aparatur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "slug": { "type": "string", "maxLength": 300 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 10000 },
        "contextHeader": { "type": "string", "maxLength": 300 },
        "contextExplanation": { "type": "string", "maxLength": 50000 },
        "conceptA": { "type": "object" },
        "conceptB": { "type": "object" },
        "comparison": { "type": "object" },
        "simultaneousExplanation": { "type": "string", "maxLength": 20000 },
        "generalContent": { "type": "string", "maxLength": 50000 },
        "classifications": { "type": "array" },
        "requirementsHeader": { "type": "string", "maxLength": 300 },
        "requirements": { "type": "array" },
        "processStepsHeader": { "type": "string", "maxLength": 300 },
        "processSteps": { "type": "array" },
        "faqs": { "type": "array" },
        "thumbnail": { "type": "string", "maxLength": 700000 },
        "instagramPostUrl": { "type": "string", "maxLength": 2000 },
        "instagramThumbnail": { "type": "string", "maxLength": 700000 },
        "isCustomThumbnail": { "type": "boolean" },
        "customThumbnail": { "type": "string", "maxLength": 700000 },
        "autoThumbnail": { "type": "string", "maxLength": 700000 },
        "instagramDate": { "type": "string", "maxLength": 100 },
        "instagramAccountHandle": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "review", "published"] },
        "sources": { "type": "array" },
        "relatedPolicyIds": { "type": "array" },
        "publicationDate": { "type": "string", "maxLength": 100 },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "aiAssisted": { "type": "boolean" },
        "aiSummary": { "type": "string", "maxLength": 10000 },
        "isAiSummaryApproved": { "type": "boolean" },
        "aiSummaryGeneratedAt": { "type": "string", "maxLength": 64 },
        "instagramCaption": { "type": "string", "maxLength": 20000 }
      },
      "required": ["id", "title", "slug", "categoryId", "status", "createdAt", "updatedAt"]
    },
    "DeputyNews": {
      "title": "DeputyNews",
      "description": "Warta dan siaran pers resmi Kedeputian SDM Aparatur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 300 },
        "articleUrl": { "type": "string", "maxLength": 2000 },
        "thumbnailUrl": { "type": "string", "maxLength": 700000 },
        "imageId": { "type": "string", "maxLength": 128 },
        "publicationDate": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "articleUrl", "publicationDate", "summary", "status", "createdAt", "updatedAt"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Slide visual banner pada halaman beranda",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 700000 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "imageUrl", "order", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Topik klaster ASN dan pilar komunikasi publik",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "iconName": { "type": "string", "maxLength": 50 },
        "group": { "type": "string", "enum": ["klaster", "pilar"] },
        "colorScheme": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "slug", "description"]
    },
    "AboutPage": {
      "title": "AboutPage",
      "description": "Profil Kedeputian, pimpinan, dan unit kerja",
      "type": "object",
      "properties": {
        "heading": { "type": "string", "maxLength": 300 },
        "subheading": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "profileImageUrl": { "type": "string", "maxLength": 700000 },
        "profileImageUpdatedAt": { "type": ["string", "null"], "maxLength": 64 },
        "orgSectionTitle": { "type": "string", "maxLength": 200 },
        "orgTopLevelTitle": { "type": "string", "maxLength": 200 },
        "unitSectionTitle": { "type": "string", "maxLength": 200 },
        "unitSectionSubtitle": { "type": "string", "maxLength": 500 },
        "units": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["heading", "subheading"]
    },
    "Source": {
      "title": "Source",
      "description": "Regulasi rujukan hukum JDIH",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 500 },
        "regulationType": { "type": "string", "maxLength": 150 },
        "regulationNumber": { "type": "string", "maxLength": 150 },
        "year": { "type": "string", "maxLength": 20 },
        "articles": { "type": "string", "maxLength": 500 },
        "fileUrl": { "type": "string", "maxLength": 2000 },
        "description": { "type": "string", "maxLength": 2000 },
        "isVerified": { "type": "boolean" }
      },
      "required": ["id", "title"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Akun administrator terverifikasi berbasis Firebase Auth UID untuk otorisasi Portal Admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["superadmin", "content_manager", "legal_reviewer", "editor"], "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "roleTitle": { "type": "string", "maxLength": 150 },
        "department": { "type": "string", "maxLength": 250 },
        "permissions": { "type": "object" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/policies/{policyId}": {
      "schema": "Policy",
      "description": "Koleksi kebijakan dan materi edukasi KOMPAK SDMA"
    },
    "/deputy_news/{newsId}": {
      "schema": "DeputyNews",
      "description": "Koleksi berita resmi Kedeputian SDM Aparatur"
    },
    "/hero_slides/{slideId}": {
      "schema": "HeroSlide",
      "description": "Koleksi slide banner beranda"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Koleksi kategori klaster dan pilar konten"
    },
    "/about_page/{docId}": {
      "schema": "AboutPage",
      "description": "Dokumen informasi dan profil Kedeputian"
    },
    "/sources/{sourceId}": {
      "schema": "Source",
      "description": "Koleksi dasar hukum regulasi"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Koleksi data otorisasi admin portal"
    }
  }
}
